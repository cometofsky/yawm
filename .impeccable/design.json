  "components": [
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button",
      "description": "Tactile action with visible focus and a shallow press.",
      "html": "<button class=\"ds-button\">Done</button>",
      "css": ".ds-button{font-family:Arial,Helvetica,sans-serif;font-weight:800;min-width:44px;min-height:44px;padding:.6rem .85rem;border-radius:9px;border:1px solid var(--muted,#c7b4c4);background:transparent;color:var(--text,#f7ecee);transition:background-color 200ms ease,transform 180ms ease}.ds-button:hover{background:var(--surface-raised,#372b3b)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid var(--accent,#dfc09a);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Tactile action with visible focus and a shallow press.",
      "html": "<button class=\"ds-primary\">Done</button>",
      "css": ".ds-primary{font-family:Arial,Helvetica,sans-serif;font-weight:800;min-width:44px;min-height:44px;padding:.6rem .85rem;border-radius:9px;border:1px solid var(--muted,#c7b4c4);background:var(--accent,#dfc09a);color:var(--selected-text,#241b28);transition:background-color 200ms ease,transform 180ms ease}.ds-primary:hover{background:var(--text,#f7ecee)}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:2px solid var(--accent,#dfc09a);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "City search",
      "kind": "input",
      "refersTo": "search",
      "description": "Offline city search field with a readable placeholder.",
      "html": "<label class=\"ds-search\">City<input placeholder=\"Search city or country\" /></label>",
      "css": ".ds-search{font-family:Arial,Helvetica,sans-serif;font-weight:800;display:block;color:var(--muted,#c7b4c4)}.ds-search input{display:block;width:100%;min-height:48px;padding:0 .7rem;border:1px solid var(--muted,#c7b4c4);border-radius:9px;background:transparent;color:var(--text,#f7ecee);font:inherit;font-size:1rem}.ds-search input::placeholder{color:var(--muted,#c7b4c4);opacity:1}.ds-search input:focus-visible{outline:2px solid var(--accent,#dfc09a);outline-offset:4px}"
    },
    {
      "name": "Local clock",
      "kind": "custom",
      "refersTo": "clock",
      "description": "Dominant fixed-width time with a large, bold date underneath; illustrative snapshot.",
      "html": "<div class=\"ds-clock-wrap\"><div class=\"ds-clock\">13:05</div><div class=\"ds-clock-date\">Sat, 24 Oct 2026</div></div>",
      "css": ".ds-clock{font-family:Menlo,Monaco,Consolas,\"Courier New\",monospace;font-variant-numeric:tabular-nums;font-weight:900;font-size:5rem;letter-spacing:-.035em;line-height:1.05;color:var(--text,#f7ecee);-webkit-text-stroke:.008em currentColor;white-space:nowrap}.ds-clock-wrap{text-align:center}.ds-clock-date{font-family:Arial,Helvetica,sans-serif;font-size:3rem;font-weight:900;line-height:1.25;color:var(--text,#f7ecee);margin-top:.65rem;overflow-wrap:break-word}@media(max-width:600px){.ds-clock-date{font-size:1.5rem}}"
    },
    {
      "name": "Hijri sighting adjustment",
      "kind": "custom",
      "refersTo": "offset-stepper",
      "description": "Visible manual correction; illustrative control sample.",
      "html": "<div class=\"ds-stepper\" role=\"group\" aria-label=\"Hijri adjustment\"><button aria-label=\"Back one day\">\u2212</button><output>0 days</output><button aria-label=\"Forward one day\">+</button></div>",
      "css": ".ds-stepper{font-family:Arial,Helvetica,sans-serif;font-weight:800;display:inline-flex;align-items:center;border:1px solid var(--muted,#c7b4c4);border-radius:9px;color:var(--text,#f7ecee)}.ds-stepper button{min-width:44px;min-height:44px;padding:.6rem;border:0;background:transparent;color:inherit;font:inherit}.ds-stepper output{font-family:Menlo,Consolas,monospace;font-size:.9375rem;min-width:4rem;text-align:center}.ds-stepper button:hover{background:var(--surface-raised,#372b3b)}.ds-stepper button:focus-visible{outline:2px solid var(--accent,#dfc09a);outline-offset:4px}"
    },
    {
      "name": "Textual switch",
      "kind": "button",
      "refersTo": "switch",
      "description": "State is explicit in text and color.",
      "html": "<button class=\"ds-switch\" role=\"switch\" aria-label=\"High contrast\" aria-checked=\"true\">On</button>",
      "css": ".ds-switch{font-family:Arial,Helvetica,sans-serif;font-weight:800;width:64px;min-height:44px;border:1px solid var(--muted,#c7b4c4);border-radius:24px;background:var(--accent,#dfc09a);color:var(--selected-text,#241b28);font-size:.9375rem;padding:6px}.ds-switch:focus-visible{outline:2px solid var(--accent,#dfc09a);outline-offset:4px}"
    },
    {
      "name": "Waqt surface",
      "kind": "card",
      "refersTo": "waqt-band",
      "description": "Compact prayer-name and Time left group; illustrative snapshot.",
      "html": "<div class=\"ds-waqt\"><strong>Dhuhr</strong><div><small>Time left</small><span>01:54:52</span></div></div>",
      "css": ".ds-waqt{font-family:Arial,Helvetica,sans-serif;font-weight:800;display:flex;flex-wrap:wrap;align-items:center;padding:1.25rem 1.75rem;background:var(--surface,#2a212e);color:var(--muted,#c7b4c4);border-radius:14px}.ds-waqt strong{font-size:2.2rem;color:var(--accent,#dfc09a)}.ds-waqt>div{margin-left:1.5rem}.ds-waqt small{display:block;font-size:.9375rem}.ds-waqt span{font-family:Menlo,Consolas,monospace;font-size:2rem;font-weight:900}"
    }
  ],
  "narrative": {
    "northStar": "Nocturne",
    "overview": "Nocturne is a matte household timepiece: warm plum grounds, pearl numerals and a restrained bronze accent. Readability from a shelf or wall decides the visual hierarchy. The owner\u2019s distance-reading refinement makes text deliberately heavy, including dates, prayer names and supporting labels.\n\nThe interface stays quiet at rest. Tonal recesses, shallow pressed controls and sparse rules provide structure; motion appears only in deliberate interactions. Original, Slate, Forest and Warm are palette variations of the same system.",
    "keyCharacteristics": [
      "Largest, brightest fixed-width local numerals; quieter, wider waqt band.",
      "Heavy offline system type, with bold sans-serif dates and prayer names.",
      "Visible Hijri sighting adjustment and persistent Accessibility and Appearance entry points.",
      "Semantic palette variations and reading-comfort settings, with no external assets."
    ],
    "rules": [
      {
        "name": "Distance First",
        "body": "Keep local time largest and brightest; make essential labels heavy and readable before adding decorative detail.",
        "section": "typography"
      },
      {
        "name": "Quiet at Rest",
        "body": "Use short interaction feedback and dialog entry only; do not animate the clock background or continuously pulse loading content.",
        "section": "elevation"
      },
      {
        "name": "Seven Columns",
        "body": "Keep calendar weekdays and days aligned in seven columns; use scoped calendar scrolling when text or touch targets need more room.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the current palette variables for surfaces, text, accents and borders.",
      "Do preserve fixed-width ticking numerals and the clock\u2019s primary hierarchy in every palette and orientation.",
      "Do use the heaviest available offline weights and keep essential labels legible from the device\u2019s intended viewing distance.",
      "Do keep the Hijri manual adjustment visible even when its headline date is switched off.",
      "Do preserve visible focus, non-color selected cues and reduced-motion behavior.",
      "Do use margins and wrapping flex layouts compatible with the legacy CSS pipeline."
    ],
    "donts": [
      "Don't restore the old equal-card hero, calendar gradients or decorative glows.",
      "Don't replace the selected heavy sans-serif dates and prayer names with the earlier preview\u2019s delicate serif styling.",
      "Don't load fonts, icons, images or data from remote services at runtime.",
      "Don't shrink the seven-column calendar to make enlarged controls appear to fit.",
      "Don't treat desktop Chromium captures or design documentation as acceptance on iOS 10.3.4 hardware."
    ]
  }
}
